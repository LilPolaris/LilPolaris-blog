[
  { "name": "split-prose", "input": "第一行\n第二行", "expected": "第一行\n\n第二行" },
  { "name": "three-lines", "input": "一\n二\n三", "expected": "一\n\n二\n\n三" },
  { "name": "keep-blank", "input": "A\n\nB", "expected": "A\n\nB" },
  { "name": "crlf", "input": "一\r\n二", "expected": "一\r\n\r\n二" },
  { "name": "fence", "input": "说明\n```js\na\nb\n```\n后文", "expected": "说明\n```js\na\nb\n```\n后文" },
  { "name": "tilde-fence", "input": "~~~\na\nb\n~~~", "expected": "~~~\na\nb\n~~~" },
  { "name": "list", "input": "段落\n- a\n- b", "expected": "段落\n- a\n- b" },
  { "name": "ordered-list", "input": "1. a\n2. b", "expected": "1. a\n2. b" },
  { "name": "list-continuation", "input": "- item\n  续行", "expected": "- item\n  续行" },
  { "name": "table", "input": "| a | b |\n|---|---|\n| 1 | 2 |", "expected": "| a | b |\n|---|---|\n| 1 | 2 |" },
  { "name": "quote", "input": "> a\n> b", "expected": "> a\n> b" },
  { "name": "html", "input": "<div>\n文字\n文字\n</div>", "expected": "<div>\n文字\n文字\n</div>" },
  { "name": "html-ends-at-blank", "input": "<div>x</div>\n\n一\n二", "expected": "<div>x</div>\n\n一\n\n二" },
  { "name": "math", "input": "$$\na\nb\n$$", "expected": "$$\na\nb\n$$" },
  { "name": "hexo-tag-block", "input": "{% note info %}\n一\n二\n{% endnote %}", "expected": "{% note info %}\n一\n二\n{% endnote %}" },
  { "name": "hexo-inline-tag", "input": "{% asset_img a.png 图 %}\n正文", "expected": "{% asset_img a.png 图 %}\n正文" },
  { "name": "heading", "input": "# 标题\n正文", "expected": "# 标题\n正文" },
  { "name": "setext", "input": "文字\n---", "expected": "文字\n---" },
  { "name": "hard-break-spaces", "input": "一  \n二", "expected": "一  \n二" },
  { "name": "hard-break-backslash", "input": "一\\\n二", "expected": "一\\\n二" },
  { "name": "footnote-def", "input": "[^1]: 注释\n正文", "expected": "[^1]: 注释\n正文" },
  { "name": "prose-after-fence", "input": "```\nx\n```\n一\n二", "expected": "```\nx\n```\n一\n\n二" }
