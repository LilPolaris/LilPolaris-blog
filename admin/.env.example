# GitHub service token: server only, never prefix with NEXT_PUBLIC_.
GITHUB_TOKEN=
GITHUB_OWNER=LilPolaris
GITHUB_REPO=LilPolaris-blog
GITHUB_BRANCH=main

HEXO_POSTS_PATH=source/_posts
HEXO_DRAFTS_PATH=source/_drafts
HEXO_IMAGES_PATH=source/img
PUBLIC_BLOG_URL=https://lilpolaris.github.io
BLOG_TIMEZONE=Asia/Shanghai
GITHUB_WORKFLOW_ID=deploy.yml

ADMIN_GITHUB_LOGIN=LilPolaris
# oauth for deployed environments; local-cli is only for a localhost-bound launcher.
AUTH_MODE=oauth
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Required only when an OAuth/production deployment intentionally writes main.
# Preview deployments can never write main, even if this value is set.
CONTENT_WRITE_POLICY=

DEFAULT_LAYOUT=post
DEFAULT_CATEGORY=
DEFAULT_COMMIT_TEMPLATE=content: {action} post {slug}
EDITOR_DEFAULT_MODE=live
AUTO_DISPATCH_WORKFLOW=false
# Browser source/recovery limit. Vercel-bound staged files are capped at 3.5 MiB in code.
MAX_UPLOAD_MB=8

# Use mock to develop without reading or writing the real repository.
REPOSITORY_ADAPTER=github

# AI article metadata (server only). Paste the DeepSeek key on the Settings page.
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
AI_API_KEY=
AI_TIMEOUT_MS=45000

# Local Ollama alternative:
# AI_PROVIDER=ollama
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=qwen3.5:9b
# AI_API_KEY=ollama
