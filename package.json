{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "hexo generate",
    "clean": "hexo clean",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/push-post.ps1",
    "images": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/add-post-images.ps1",
    "new": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/new-post.ps1",
    "push": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/push-post.ps1",
    "server": "hexo server",
    "test": "node --test \"tools/*.test.mjs\"",
    "test:site": "hexo clean && hexo generate && node --test tools/site-build.check.mjs"
  },
  "hexo": {
    "version": "8.1.1"
  },
  "dependencies": {
    "@fontsource/long-cang": "^5.3.0",
    "@fontsource/ma-shan-zheng": "^5.3.1",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "hexo": "^8.0.0",
    "hexo-butterfly-extjs": "^1.5.8",
    "hexo-deployer-git": "^4.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-baidu-sitemap": "^0.1.9",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^4.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-searchdb": "^1.5.0",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-wordcount": "^6.0.1"
  }
}
